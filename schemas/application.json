{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sih26129.gov.in/schemas/application.json",
  "title": "Application",
  "description": "Canonical application schema — unified representation of applications/requests across all departments. References IndEA service-request entity pattern.",
  "type": "object",
  "required": ["applicationId", "canonicalCitizenId", "department", "type", "status"],
  "properties": {
    "applicationId": {
      "type": "string",
      "description": "Canonical application identifier (UUID)."
    },
    "canonicalCitizenId": {
      "type": "string",
      "description": "References the citizen's canonical ID from the MDM golden record."
    },
    "department": {
      "type": "string",
      "enum": ["DEPT_A", "DEPT_B", "DEPT_C"],
      "description": "Originating department."
    },
    "type": {
      "type": "string",
      "enum": ["SKILL_CERTIFICATION", "JOB_APPLICATION", "GRIEVANCE"],
      "description": "Application type — maps to the department's domain."
    },
    "status": {
      "type": "string",
      "enum": ["SUBMITTED", "UNDER_REVIEW", "VERIFIED", "APPROVED", "REJECTED", "RESOLVED", "CLOSED"],
      "description": "Current status in the canonical status taxonomy."
    },
    "departmentRefId": {
      "type": "string",
      "description": "The application's native ID in the originating department (e.g. course_id, JobRefNo, complaint_id)."
    },
    "departmentCitizenId": {
      "type": "string",
      "description": "The citizen's ID as known to the originating department."
    },
    "title": {
      "type": ["string", "null"],
      "description": "Human-readable application title/subject.",
      "maxLength": 300
    },
    "details": {
      "type": ["object", "null"],
      "description": "Department-specific details (free-form JSON)."
    },
    "submittedAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "slaDeadline": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "SLA deadline for processing."
    }
  }
}
